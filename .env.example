# VisionFlow local environment template
# Copy this file to .env, replace every secret, and never commit .env.
#
# Security preflight:
#   python scripts/visionflow_config_preflight.py --root .
# Compose interpolation also blocks startup when required secrets are empty.

# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=visionflow
MYSQL_USER=visionflow
MYSQL_PASSWORD=change_me

# Operator RBAC
VISIONFLOW_OPERATOR_SECURITY_ENABLED=true
VISIONFLOW_VIEWER_NAME=demo-viewer
VISIONFLOW_VIEWER_KEY=
VISIONFLOW_OPERATOR_NAME=demo-operator
VISIONFLOW_OPERATOR_KEY=
VISIONFLOW_ADMIN_NAME=demo-admin
VISIONFLOW_ADMIN_KEY=

# Automatic one-time operator account bootstrap.
# Temporary passwords are generated with SecureRandom and written only to the
# backend data volume until each account completes its first password change.
VISIONFLOW_OPERATOR_ACCOUNT_BOOTSTRAP_ENABLED=true
VISIONFLOW_OPERATOR_BOOTSTRAP_CREDENTIAL_FILE=/app/data/operator-bootstrap/initial-credentials.txt

# Browser authentication
VISIONFLOW_WEB_AUTH_MODE=session
VISIONFLOW_WEB_SECURE_COOKIES=true
# Used only when VISIONFLOW_WEB_AUTH_MODE=static.
VISIONFLOW_FRONTEND_OPERATOR_KEY=

# AI snapshot privacy policy.
# OFF: automatic JPEG persistence disabled (privacy-safe default).
# MANUAL: automatic persistence disabled; explicit manual workflow only.
# INCIDENT_ONLY: persist a JPEG only for events that pass the AI hard event gate.
AI_SNAPSHOT_POLICY=OFF

# AI internal service authentication
VISIONFLOW_AI_INTERNAL_SECURITY_ENABLED=true
VISIONFLOW_AI_INTERNAL_KEY=

# DJI Android Bridge authentication. Use a distinct 32+ character secret.
# Required only when compose.dji-bridge.yaml is enabled.
VISIONFLOW_DJI_BRIDGE_KEY=
