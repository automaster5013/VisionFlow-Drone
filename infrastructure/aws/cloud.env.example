# Copy to /home/ubuntu/visionflow-cloud/.env on the EC2 host and chmod 600.
# Never commit the real .env file.

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=visionflow
MYSQL_USER=visionflow
MYSQL_PASSWORD=replace-with-strong-application-password

SPRING_DATASOURCE_USERNAME=visionflow
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-application-password

VISIONFLOW_OPERATOR_SECURITY_ENABLED=true
VISIONFLOW_VIEWER_NAME=viewer
VISIONFLOW_VIEWER_KEY=replace-with-random-viewer-key-at-least-32-chars
VISIONFLOW_OPERATOR_NAME=operator
VISIONFLOW_OPERATOR_KEY=replace-with-random-operator-key-at-least-32-chars
VISIONFLOW_ADMIN_NAME=admin
VISIONFLOW_ADMIN_KEY=replace-with-random-admin-key-at-least-32-chars

VISIONFLOW_BACKEND_IMAGE=automaster5013/visionflow-drone:backend-sha-52e847e
VISIONFLOW_BACKEND_EXPECTED_DIGEST=sha256:94d53419ae1a93809c7692350db792b208ee488813f62fd64b17dc4b586a06b3
