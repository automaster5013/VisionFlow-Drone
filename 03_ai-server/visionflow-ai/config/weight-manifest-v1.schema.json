{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionflow.local/schemas/weight-manifest-v1.schema.json",
  "title": "VisionFlow Phase 2B-1 Weight Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "manifestVersion",
    "template",
    "model",
    "classes",
    "data",
    "training",
    "runtime",
    "inference",
    "evaluation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "visionflow.phase2b1.visdrone-weight-contract" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "template": { "const": false },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "role",
        "family",
        "scale",
        "task",
        "trainingStage",
        "activationEligible",
        "weight",
        "lineage"
      ],
      "properties": {
        "profile": {
          "enum": ["GENERAL_LIVE", "AERIAL_SMALL_OBJECT_LIVE"]
        },
        "role": {
          "enum": ["GENERAL_DETECTION", "AERIAL_SMALL_OBJECT_DETECTION"]
        },
        "family": { "const": "YOLO26" },
        "scale": { "const": "m" },
        "task": { "const": "detect" },
        "trainingStage": {
          "enum": ["COCO_BASE", "VISDRONE_S1", "VISIONFLOW_S2"]
        },
        "activationEligible": { "type": "boolean" },
        "weight": { "$ref": "#/$defs/weight" },
        "lineage": { "$ref": "#/$defs/lineage" }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/classMapping" }
    },
    "data": { "$ref": "#/$defs/data" },
    "training": { "$ref": "#/$defs/training" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "inference": { "$ref": "#/$defs/inference" },
    "evaluation": { "$ref": "#/$defs/evaluation" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[^/\\\\]+\\.pt$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentFileName", "parentSha256"],
      "properties": {
        "parentFileName": { "type": "string", "minLength": 1 },
        "parentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceName", "canonicalName", "trackKind"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "sourceName": { "type": "string", "minLength": 1 },
        "canonicalName": { "type": "string", "minLength": 1 },
        "trackKind": { "enum": ["HUMAN", "VEHICLE", "CYCLE", "OTHER"] }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetName", "datasetVersion", "datasetFingerprintSha256", "splitPolicy"],
      "properties": {
        "datasetName": { "type": "string", "minLength": 1 },
        "datasetVersion": { "type": "string", "minLength": 1 },
        "datasetFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "splitPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "adjacentFramesAcrossSplits",
            "finalEvaluationExcludedFromTraining",
            "splitManifestSha256"
          ],
          "properties": {
            "unit": {
              "enum": ["VIDEO_SEQUENCE", "OFFICIAL_DATASET_SPLIT"]
            },
            "adjacentFramesAcrossSplits": { "const": false },
            "finalEvaluationExcludedFromTraining": { "const": true },
            "splitManifestSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageSize", "epochs", "batch", "seed"],
      "properties": {
        "imageSize": { "type": "integer", "minimum": 1 },
        "epochs": { "type": "integer", "minimum": 1 },
        "batch": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "ultralytics", "torch", "cuda"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "ultralytics": { "type": "string", "minLength": 1 },
        "torch": { "type": "string", "minLength": 1 },
        "cuda": { "type": "string", "minLength": 1 }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultHeadMode", "supportedHeadModes"],
      "properties": {
        "defaultHeadMode": { "enum": ["END_TO_END", "ONE_TO_MANY_NMS"] },
        "supportedHeadModes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["END_TO_END", "ONE_TO_MANY_NMS"] }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "precision", "recall", "map50", "map50_95", "smallObject", "perClass"],
      "properties": {
        "status": { "const": "MEASURED" },
        "precision": { "$ref": "#/$defs/ratio" },
        "recall": { "$ref": "#/$defs/ratio" },
        "map50": { "$ref": "#/$defs/ratio" },
        "map50_95": { "$ref": "#/$defs/ratio" },
        "smallObject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "recall", "missRate"],
          "properties": {
            "definition": {
              "const": "COCO_AREA_LT_32_SQUARED_PX_AT_ORIGINAL_RESOLUTION"
            },
            "recall": { "$ref": "#/$defs/ratio" },
            "missRate": { "$ref": "#/$defs/ratio" }
          }
        },
        "perClass": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceName", "precision", "recall", "map50", "map50_95"],
            "properties": {
              "sourceName": { "type": "string", "minLength": 1 },
              "precision": { "$ref": "#/$defs/ratio" },
              "recall": { "$ref": "#/$defs/ratio" },
              "map50": { "$ref": "#/$defs/ratio" },
              "map50_95": { "$ref": "#/$defs/ratio" }
            }
          }
        }
      }
    }
  }
}
